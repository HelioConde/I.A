{
  "schema_version": 1,
  "provenance": "Original benchmark contracts authored for Luna; not copied from third-party source code.",
  "tasks": [
    {
      "id": "movement",
      "skill": "fsm",
      "language": "javascript",
      "instruction": "Implement a pure function step(state,input,dt) with horizontal motion and gravity; return a new state, avoid mutation.",
      "required_exports": [
        "step"
      ],
      "cases": [
        {
          "state": {
            "x": 0,
            "y": 0,
            "vx": 0,
            "vy": 0
          },
          "input": {
            "right": true
          },
          "dt": 1,
          "expected": {
            "x": 5,
            "y": 10,
            "vx": 5,
            "vy": 10
          }
        },
        {
          "state": {
            "x": 3,
            "y": 2,
            "vx": 0,
            "vy": 0
          },
          "input": {
            "left": true
          },
          "dt": 0.5,
          "expected": {
            "x": 0.5,
            "y": 4.5,
            "vx": -5,
            "vy": 5
          }
        }
      ],
      "contract": {
        "speed": 5,
        "gravity": 10
      }
    },
