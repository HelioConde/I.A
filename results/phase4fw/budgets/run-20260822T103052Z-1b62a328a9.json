        "score": 0.4140592595752845,
        "section": "tclsqlite",
        "source_id": "sqlite-3.53.4-docs",
        "start": 310,
        "text": "When SQLite tries to open a database and finds that it is locked, it can optionally delay for a short while and try to open the file again.",
        "title": "tclsqlite"
      },
