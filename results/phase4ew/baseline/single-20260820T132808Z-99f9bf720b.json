            "source_id": "python-3.14.7-docs"
          },
          {
            "document": "python-3.14-docs-text/library/json.txt",
            "excerpt": ">>> import json >>> class ComplexEncoder(json.JSONEncoder): ... def default(self, obj): ... if isinstance(obj, complex): ... return [obj.real, obj.imag] ... # Let the base class default method raise the TypeError ... return super().default(obj) ... >>> json.dumps(2 + 1j, cls=Comp",
            "page_id": 3,
            "record_id": "859fda16a4d715b5f6c73141",
            "section": "json",
